---
// Site header with brand, primary nav, search, language & theme toggles.
const { lang = 'en', active = 'home' } = Astro.props;
const zh = lang === 'zh';
// Deployment base (e.g. '/OmniPrep') — prefix every in-site URL so links and
// assets resolve correctly under GitHub Pages project sites.
const baseUrl = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const base = `${baseUrl}${zh ? '/zh' : ''}`;
const links = zh
  ? [
      { href: `${base}/`, key: 'home', label: '首页' },
      { href: `${base}/getting-started/`, key: 'start', label: '快速开始' },
      { href: `${base}/documentation/`, key: 'docs', label: '文档' },
      { href: `${base}/changelog/`, key: 'log', label: '更新日志' },
      { href: `${base}/about/`, key: 'about', label: '关于' },
    ]
  : [
      { href: `${base}/`, key: 'home', label: 'Home' },
      { href: `${base}/getting-started/`, key: 'start', label: 'Getting Started' },
      { href: `${base}/documentation/`, key: 'docs', label: 'Documentation' },
      { href: `${base}/changelog/`, key: 'log', label: 'Changelog' },
      { href: `${base}/about/`, key: 'about', label: 'About' },
    ];
const cta = zh ? { href: `${base}/getting-started/`, label: '快速开始' } : { href: `${base}/getting-started/`, label: 'Get Started' };
const searchHref = `${base}/search/`;

// Map the current path to the equivalent path in the other language,
// so the language toggle stays on the same page (not the homepage).
const pathname = Astro.url.pathname.replace(/\/+$/, '');
const relPath = pathname.replace(new RegExp(`^${baseUrl}`), ''); // strip base
const altLangHref = zh
  ? `${baseUrl}${relPath.replace(/^\/zh/, '')}` || `${baseUrl}/`
  : `${baseUrl}/zh${relPath}`;
const altLangLabel = zh ? 'EN' : '中';
const altLangTitle = zh ? 'Switch to English' : '切换到中文';
const asset = (p) => `${baseUrl}${p}`;
---

<div class="topbar">
  {zh
    ? 'OmniPrep 正在积极开发中——文档与使用说明持续更新。'
    : 'OmniPrep is under active development — early documentation and usage preview.'}
</div>

<header class="site-header">
  <div class="container">
    <a class="brand" href={base + '/'}>
      <img class="brand-mark" src={asset('/assets/img/logo.svg')} alt="OmniPrep logo" />
      <span class="brand-name">Omni<span>Prep</span></span>
    </a>
    <nav class="main-nav" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class={active === l.key ? 'active' : ''}>{l.label}</a>
      ))}
      <a class="nav-icon-btn" href={searchHref} aria-label="Search" title={zh ? '搜索' : 'Search'}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      </a>
      <a class="nav-icon-btn lang-btn" href={altLangHref} aria-label={altLangTitle} title={altLangTitle}><span>{altLangLabel}</span></a>
      <button class="nav-icon-btn theme-toggle" aria-label="Toggle theme" title="Toggle light / dark">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
      </button>
      <a class="nav-cta" href={cta.href}>{cta.label}</a>
    </nav>
    <button class="nav-toggle" aria-label="Toggle navigation">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
  </div>
</header>
