---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../config';
const baseUrl = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
---
<Layout lang="zh" title="搜索 — OmniPrep" description="搜索 OmniPrep 文档。" active="">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href={`${baseUrl}/zh/`}>首页</a><span class="sep">/</span>搜索</div>
      <h1>搜索文档</h1>
      <p class="lead">输入关键词，搜索全部 OmniPrep 文档。</p>
    </div>
  </section>
  <div class="container" style="max-width:860px;padding:40px 24px 80px">
    <div id="search"></div>
  </div>
  <script>
    import { PagefindUI } from '@pagefind/default-ui';
    import '@pagefind/default-ui/css/ui.css';
    new PagefindUI({ element: "#search", showSubResults: true });
  </script>
</Layout>
